    "eslint-plugin-react-hooks": "^7.0.0",
    "jest": "30.4.2",
    "jest-canvas-mock": "2.5.2",
    "jest-environment-jsdom": "30.4.1",
    "prettier": "3.8.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typedoc": "0.28.19",
