{
  "name": "@tanatloc/3d",
  "version": "2.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "depcheck": "knip --dependencies",
    "prettier": "prettier -l '**/*.{js,ts,json,md}'",
    "lint": "eslint .",
    "doc": "typedoc --options ./config/typedoc.config.js",
    "testw": "jest --config config/jest.config.js --watch",
    "test": "jest --config config/jest.config.js --silent",
    "build": "swc --config-file config/.swcrc src/ --out-dir dist --strip-leading-paths",
    "check": ".github/workflows/check.sh"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "antd": "6.5.1",
    "three": "0.185.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@2ltech/jest-ant-design-icons": "1.0.2",
    "@babel/core": "8.0.1",
    "@eslint/js": "10.0.1",
    "@react-three/test-renderer": "9.1.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.46",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "babel-jest": "30.4.1",
    "eslint": "10.7.0",
    "eslint-plugin-react": "7.37.5",
    "jest": "30.4.2",
    "jest-canvas-mock": "2.5.8",
    "jest-environment-jsdom": "30.4.1",
    "knip": "6.27.0",
    "prettier": "3.9.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "ts-jest": "29.4.11",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0"
  }
