    "three": "0.184.0",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/plugin-syntax-import-assertions": "7.28.6",
    "@babel/plugin-syntax-jsx": "7.28.6",
    "@babel/preset-env": "7.29.5",
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@eslint/js": "10.0.1",
