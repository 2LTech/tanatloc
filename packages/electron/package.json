{
  "name": "@tanatloc/electron",
  "version": "2.0.0",
  "private": true,
  "description": "Tanatloc Electron App",
  "license": "AGPL-3.0-or-later",
  "main": "./main/index.js",
  "author": {
    "name": "Airthium",
    "url": "https://github.com/orgs/Airthium/people"
  },
  "scripts": {
    "clean": "rm -rf dist dist-install dist-server main renderer",
    "depcheck": "node config/depcheck.js",
    "prettier": "prettier -l '**/*.{js,jsx,ts,tsx,json,md,css}'",
    "test": "jest --config config/jest.config.js  --coverage --silent",
    "doc": "typedoc --options config/typedoc.config.json",
    "pre-build": "node esm_commonjs/index.js",
    "build-renderer": "echo Build renderer && cd ../core && NEXT_PUBLIC_SERVER_MODE=server next build",
    "build-electron": "echo Build electron && tsc -p electron-src",
    "build-install": "echo Build install && yarn build-install:config && yarn build-install:database && yarn build-install:init && yarn build-install:package && yarn build-install:install",
    "build-install:config": "echo - Config && babel ../core/config/db.ts --extensions .ts --config-file ./install/.babelrc --out-dir dist-install/config && babel ../core/config/storage.ts --extensions .ts --config-file ./install/.babelrc --out-dir dist-install/config",
    "build-install:database": "echo - Database && babel ../core/src/database/index.ts --extensions .ts --config-file ./install/.babelrc --out-dir dist-install/src/database",
    "build-install:init": "echo - Init && babel ../core/src/server/init/database.ts --extensions .ts --config-file ./install/.babelrc --out-dir dist-install/src/server/init",
    "build-install:package": "echo - Package.json && node install/package.js",
    "build-install:install": "echo - Install && babel ../core/install --extensions .ts --config-file ./install/.babelrc --out-dir dist-install/install --ignore '**/__tests__/**'",
    "build-server": "echo Build server && yarn build-server:server && yarn build-server:config && yarn build-server:src && yarn build-server:models && yarn build-server:plugins && yarn build-server:mathjax && yarn build-server:templates && yarn build-server:postprocessing",
    "build-server:server": "echo - Server && babel server --extensions .ts --config-file ./server/.babelrc --out-dir dist-server/server --ignore '**/__tests__/**'",
    "build-server:config": "echo - Config && babel ../core/config/*.ts --extensions .ts --config-file ./server/.babelrc --out-dir dist-server/tanatloc/config",
    "build-server:src": "yarn build-server:src:auth && yarn build-server:src:database && yarn build-server:src:lib && yarn build-server:src:route && yarn build-server:src:server && yarn build-server:src:services",
    "build-server:src:auth": "echo - Src/auth && babel ../core/src/auth --extensions .ts --config-file ./server/.babelrc --out-dir dist-server/tanatloc/src/auth --ignore '**/__tests__/**'",
    "build-server:src:database": "echo - Src/database && babel ../core/src/database --extensions .ts --config-file ./server/.babelrc --out-dir dist-server/tanatloc/src/database --ignore '**/__tests__/**'",
    "build-server:src:lib": "echo - Src/lib && babel ../core/src/lib --extensions .ts --config-file ./server/.babelrc --out-dir dist-server/tanatloc/src/lib --ignore '**/__tests__/**'",
    "build-server:src:route": "echo - Src/route && babel ../core/src/route --extensions .ts --config-file ./server/.babelrc --out-dir dist-server/tanatloc/src/route --ignore '**/__tests__/**'",
    "build-server:src:server": "echo - Src/server && babel ../core/src/server --extensions .ts --config-file ./server/.babelrc --out-dir dist-server/tanatloc/src/server --ignore '**/__tests__/**'",
    "build-server:src:services": "echo - Src/services && babel ../core/src/services --extensions .ts --config-file ./server/.babelrc --out-dir dist-server/tanatloc/src/services --ignore '**/__tests__/**'",
    "build-server:models": "echo - Src/models && babel ../core/models --extensions .ts --config-file ./server/.babelrc --out-dir dist-server/tanatloc/models --ignore '**/__tests__/**'",
    "build-server:templates": "echo - Src/templates && babel ../core/templates --extensions .ts --config-file ./server/.babelrc --out-dir dist-server/tanatloc/templates --ignore '**/__tests__/**' --copy-files --no-copy-ignored",
    "build-server:plugins": "echo - Src/plugins && babel ../core/plugins --extensions .ts,.tsx --config-file ./server/.babelrc --out-dir dist-server/tanatloc/plugins --ignore '**/__tests__/**' --copy-files --no-copy-ignored",
    "build-server:mathjax": "echo - Src/components/assets/mathjax && babel ../core/src/components/assets/mathjax --extensions .ts,.tsx --config-file ./server/.babelrc --out-dir dist-server/tanatloc/src/components/assets/mathjax --ignore '**/__tests__/**' --copy-files --no-copy-ignored",
    "build-server:postprocessing": "echo - Src/postprocessing && babel ../core/postprocessing --extensions .ts --config-file ./server/.babelrc --out-dir dist-server/tanatloc/postprocessing --ignore '**/__tests__/**' --copy-files --no-copy-ignored",
    "build": "yarn pre-build && yarn build-install && yarn build-server && yarn build-renderer && yarn build-electron",
    "dist": "yarn build && echo Build application && electron-builder"
  },
  "dependencies": {
    "@2ltech/extract-json-from-string": "1.0.7",
    "@2ltech/pg-format": "1.0.9",
    "@babel/runtime": "8.0.0",
    "@hapi/iron": "7.0.1",
    "@sentry/electron": "7.13.0",
    "@sentry/nextjs": "10.59.0",
    "@tanatloc/core": "workspace:^",
    "@tanatloc/formula-validator": "workspace:^",
    "archiver": "8.0.0",
    "cors": "2.8.6",
    "ejs": "6.0.1",
    "electron-serve": "3.0.1",
    "electron-store": "11.0.2",
    "express": "5.2.1",
    "fix-path": "5.0.0",
    "form-data": "4.0.6",
    "http-errors": "2.0.1",
    "https-proxy-agent": "9.1.0",
    "is-docker": "4.0.0",
    "is-electron": "2.2.2",
    "lodash": "4.18.1",
    "mailersend": "3.0.0",
    "node-fetch": "3.3.2",
    "passport": "0.7.0",
    "passport-local": "1.0.0",
    "pg": "8.22.0",
    "react-cookie": "8.1.2",
    "set-interval-async": "3.0.3",
    "sharp": "0.35.1",
    "tar": "7.5.16",
    "url-join": "5.0.0",
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@2ltech/deep-object-diff": "1.1.8",
    "@ant-design/icons": "6.2.5",
    "@babel/cli": "8.0.1",
    "@babel/core": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@swc/core": "1.15.41",
    "@tanatloc/3d": "workspace:^",
    "@testing-library/react": "16.3.2",
    "@types/archiver": "8.0.0",
    "@types/cookie": "1.0.0",
    "@types/cors": "2.8.19",
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.6",
    "@types/http-errors": "2.0.5",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.24",
    "@types/node": "26.0.0",
    "@types/passport": "1.0.17",
    "@types/passport-local": "1.0.38",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/set-interval-async": "3.0.1",
    "@types/sharp": "0.32.0",
    "@types/tar": "7.0.87",
    "@types/url-join": "5.0.0",
    "@types/uuid": "11.0.0",
    "ajv": "8.20.0",
    "antd": "6.4.4",
    "babel-plugin-module-resolver": "5.0.3",
    "cookie": "1.1.1",
    "depcheck": "1.4.7",
    "electron": "42.4.1",
    "electron-builder": "26.15.3",
    "email-addresses": "5.0.0",
    "eslint": "10.5.0",
    "eslint-config-next": "16.2.9",
    "html-react-parser": "6.1.3",
    "jest": "30.4.2",
    "mathjax": "4.1.2",
    "next": "16.2.9",
    "prettier": "3.8.4",
    "react": "19.2.7",
    "react-ace": "14.0.1",
    "react-dom": "19.2.7",
    "recharts": "3.8.1",
    "swr": "2.4.1",
    "typedoc": "0.28.19",
    "typescript": "6.0.3"
  }
}
